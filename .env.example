# Contact form email delivery (optional in dev, required in production).
# Uses Resend (https://resend.com). Without these, the /api/contact route
# validates and logs the message server-side and still returns success so the
# site is demoable, but no email is actually sent.

# Your Resend API key.
RESEND_API_KEY=

# Where enquiries should be delivered (the client's mailbox).
CONTACT_TO_EMAIL=

# Verified sender. Defaults to Resend's onboarding address if unset.
# CONTACT_FROM_EMAIL=WCS Website <enquiries@wcsbuildingservices.co.uk>
