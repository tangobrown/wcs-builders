# Contact form email delivery via Postmark (https://postmarkapp.com).
# Without these the /api/contact route validates and logs the message
# server-side and still returns success, so the site is demoable — but no email
# is sent. Set all three before launch.

# Postmark Server API token (Server → API Tokens). SECRET — server-side only.
POSTMARK_SERVER_TOKEN=

# Where enquiries are delivered (the client's mailbox).
CONTACT_TO_EMAIL=

# Verified Postmark sender signature or an address on a verified domain.
CONTACT_FROM_EMAIL=enquiries@wcsbuildingservices.co.uk

# Optional — Postmark message stream (defaults to "outbound").
# POSTMARK_MESSAGE_STREAM=outbound
